---
import LikeButton from "./LikeButton.jsx";
---

<div
  class="likes-card h-40 lg:h-auto dark:bg-zinc-900 rounded-2xl lg:col-span-2 lg:row-span-2 lg:col-start-4 lg:row-start-5"
>
  <LikeButton client:only="react" repo="YetonDew/portfolio" />
</div>

<style>
  .likes-card {
    background:
      radial-gradient(
        circle at 20% 30%,
        rgba(34, 197, 94, 0.18),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 75%,
        rgba(74, 222, 128, 0.14),
        transparent 60%
      ),
      linear-gradient(140deg, #ecf6d8, #cbfadc 52%, #bbd9f7);
  }

  :global(.dark) .likes-card {
    background: rgb(24, 24, 27);
  }
</style>
