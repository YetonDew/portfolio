---
import Toggle from "./Toggle.astro";
---

<div
  class="toggle-card py-4 lg:py-0 dark:bg-zinc-900 rounded-2xl flex justify-center items-center lg:col-span-2 lg:row-span-2 lg:col-start-6 lg:row-start-5"
>
  <Toggle />
</div>

<style>
  .toggle-card {
    background:
      radial-gradient(
        circle at 15% 25%,
        rgba(168, 85, 247, 0.15),
        transparent 55%
      ),
      radial-gradient(
        circle at 85% 80%,
        rgba(236, 72, 153, 0.12),
        transparent 60%
      ),
      linear-gradient(135deg, #f5f9ff, #e8fdff 50%, #e9f5fe);
  }

  :global(.dark) .toggle-card {
    background: rgb(24, 24, 27);
  }
</style>
