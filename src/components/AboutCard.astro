---
import { getEntry } from "astro:content";

const aboutEntry = await getEntry("about", "about-me");
const fallbackHeadline =
  "I enjoy taking on new challenges and finding solutions...";
const MAX_HEADLINE_CHARS = 85;
const normalizedBody = aboutEntry?.body
  ?.replace(/```[\s\S]*?```/g, " ")
  ?.replace(/[#>*_`\[\]\(\)-]/g, " ")
  ?.replace(/\s+/g, " ")
  ?.trim();
const sourceHeadline = normalizedBody ?? fallbackHeadline;
const trimmedHeadline = sourceHeadline
  .slice(0, MAX_HEADLINE_CHARS)
  .trim()
  .replace(/[.,;:!?-]+$/, "");
const headlineText = `${trimmedHeadline}...`;
---

<div
  class="relative min-h-[11rem] bg-primary dark:bg-zinc-900 rounded-2xl lg:col-span-3 lg:row-span-2 lg:col-start-1 lg:row-start-5"
>
  <section
    class="flex h-full flex-col justify-center items-start gap-3 px-6 py-6 pr-24 sm:px-7 sm:py-7 lg:gap-4 lg:px-10 lg:py-10 lg:pr-24"
  >
    <p class="text-xs tracking-[0.28em] dark:text-zinc-400">A B O U T</p>
    <h1
      class="text-sm leading-relaxed text-zinc-800 dark:text-white lg:text-base"
    >
      {headlineText}
    </h1>
    <a
      href="/about"
      transition:name="about-hero-button"
      aria-label="See more details"
      title="See more details"
      class="absolute bottom-4 right-4 flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-black shadow-lg shadow-black/10 backdrop-blur-md transition-transform duration-300 ease-out hover:scale-110 dark:bg-zinc-950/80 dark:text-white"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17L17 7"></path>
        <path d="M9 7h8v8"></path>
      </svg>
    </a>
  </section>
</div>
